Cell[BoxData[{
 RowBox[{"ClearAll", "@", "supp"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"supp", "[", 
   RowBox[{"x_", ",", "size_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hCoeff", "=", "100"}], "}"}], ",", 
    RowBox[{"Triangle", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "-", "size"}], ",", 
         RowBox[{
          RowBox[{"-", "hCoeff"}], " ", "size"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "+", "size"}], ",", 
         RowBox[{
          RowBox[{"-", "hCoeff"}], " ", "size"}]}], "}"}]}], "}"}], "]"}]}], 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.855805445750842*^9, 3.855805470392804*^9}, {
   3.855805507667218*^9, 3.855805523124838*^9}, {3.855805558266306*^9, 
   3.8558055983655634`*^9}, {3.8558056331257153`*^9, 3.855805652160119*^9}, {
   3.8558061481777945`*^9, 3.855806151555327*^9}, 3.9926465601055737`*^9},
 CellLabel->"In[96]:=",ExpressionUUID->"3b588728-1ded-4c74-aad4-17c689a5b948"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "pointLoad", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "pointLoad", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<ArrowLength\>\"", "->", "55"}], ",", 
     RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.04"}], ",", 
     RowBox[{"\"\<Style\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", 
        RowBox[{"Thickness", "[", "0.008", "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Label\>\"", "->", "None"}], ",", 
     RowBox[{"\"\<LabelOffset\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"14", ",", "0"}], "}"}]}], ",", 
     RowBox[{"\"\<LabelStyle\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", "14", ",", "Italic"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pointLoad", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"xP_", "?", "NumericQ"}], ",", 
     RowBox[{"force_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "direction", ",", "arrowLength", ",", "tip", ",", "tail", ",", "label", 
       ",", "labelOffset", ",", "labelPosition"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Chop", "[", "force", "]"}], "==", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"direction", "=", 
       RowBox[{"Sign", "[", "force", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"arrowLength", "=", 
       RowBox[{"OptionValue", "[", "\"\<ArrowLength\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{"OptionValue", "[", "\"\<Label\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"labelOffset", "=", 
       RowBox[{"OptionValue", "[", "\"\<LabelOffset\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tip", "=", 
       RowBox[{"{", 
        RowBox[{"xP", ",", 
         RowBox[{"f", "[", "xP", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tail", "=", 
       RowBox[{"Offset", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"direction", " ", "arrowLength"}]}], "}"}], ",", "tip"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"labelPosition", "=", 
       RowBox[{"Offset", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"labelOffset", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"direction", " ", 
             RowBox[{"arrowLength", "/", "2"}]}], "+", 
            RowBox[{"labelOffset", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "tip"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Style\>\"", "]"}], ",", 
        RowBox[{"Arrowheads", "[", 
         RowBox[{"OptionValue", "[", "\"\<ArrowheadSize\>\"", "]"}], "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{"tail", ",", "tip"}], "}"}], "]"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"label", "===", "None"}], ",", "Nothing", ",", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"label", ",", 
              RowBox[{"OptionValue", "[", "\"\<LabelStyle\>\"", "]"}]}], 
             "]"}], ",", "labelPosition"}], "]"}]}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.992648247656473*^9, 3.992648254660364*^9}, {
  3.992648836253414*^9, 3.9926488385283966`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"33cbdbcf-0de0-6b42-938c-047a938b5ca8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "uniformDistributedLoad", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<NumberOfArrows\>\"", "->", "9"}], ",", 
      RowBox[{"\"\<ArrowLength\>\"", "->", "24"}], ",", 
      RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.025"}], ",", 
      RowBox[{"\"\<ShowLoadLine\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<Style\>\"", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", 
         RowBox[{"AbsoluteThickness", "[", "1.6", "]"}]}], "]"}]}], ",", 
      RowBox[{"\"\<Label\>\"", "->", "None"}], ",", 
      RowBox[{"\"\<LabelStyle\>\"", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "14", ",", "Italic"}], "]"}]}], ",", 
      RowBox[{"\"\<LabelGap\>\"", "->", "15"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"uniformDistributedLoad", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1_", "?", "NumericQ"}], ",", 
       RowBox[{"x2_", "?", "NumericQ"}]}], "}"}], ",", 
     RowBox[{"q_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "arrowLength", ",", "xs", ",", "beamPoints", ",", 
       "loadPoints", ",", "label", ",", "labelPoint", ",", "xMid"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Chop", "[", "q", "]"}], "==", "0"}], "||", 
         RowBox[{"x2", "<=", "x1"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"2", ",", 
         RowBox[{"Round", "@", 
          RowBox[{"OptionValue", "[", "\"\<NumberOfArrows\>\"", "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"arrowLength", "=", 
       RowBox[{"OptionValue", "[", "\"\<ArrowLength\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{"OptionValue", "[", "\"\<Label\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xs", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"x1", ",", "x2", ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"beamPoints", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"f", "[", "#", "]"}]}], "}"}], "&"}], ")"}], "/@", 
        "xs"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"loadPoints", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"Sign", "[", "q", "]"}], " ", "arrowLength"}]}], "}"}],
             ",", "#"}], "]"}], "&"}], ")"}], "/@", "beamPoints"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xMid", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x1", "+", "x2"}], ")"}], "/", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"labelPoint", "=", 
       RowBox[{"Offset", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Sign", "[", "q", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"arrowLength", "+", 
              RowBox[{"OptionValue", "[", "\"\<LabelGap\>\"", "]"}]}], 
             ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xMid", ",", 
           RowBox[{"f", "[", "xMid", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Style\>\"", "]"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "@", 
           RowBox[{"OptionValue", "[", "\"\<ShowLoadLine\>\"", "]"}]}], ",", 
          RowBox[{"Line", "[", "loadPoints", "]"}], ",", "Nothing"}], "]"}], ",", 
        RowBox[{"Arrowheads", "[", 
         RowBox[{"OptionValue", "[", "\"\<ArrowheadSize\>\"", "]"}], "]"}], ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"#1", ",", "#2"}], "}"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"loadPoints", ",", "beamPoints"}], "}"}]}], "]"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"label", "===", "None"}], ",", "Nothing", ",", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"label", ",", 
              RowBox[{"OptionValue", "[", "\"\<LabelStyle\>\"", "]"}]}], 
             "]"}], ",", "labelPoint"}], "]"}]}], "]"}]}], "}"}]}]}], "]"}]}],
   ";"}]}], "Input",
