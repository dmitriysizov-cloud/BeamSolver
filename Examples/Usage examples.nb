c205b386d239"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"L", ",", "EE", ",", "J", ",", "q", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"beam5", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Supports\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<FixedEnd\>\""}], ",", 
         RowBox[{"\"\<x\>\"", "->", "0"}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Loadings\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<Distributed\>\""}], ",", 
         RowBox[{"\"\<x begin\>\"", "->", "0"}], ",", 
         RowBox[{"\"\<x end\>\"", "->", "L"}], ",", 
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"-", "q"}]}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Length\>\"", "->", "L"}], ",", 
     RowBox[{"\"\<E\>\"", "->", "EE"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
     RowBox[{"\"\<Numbers\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"L", "->", "4"}], ",", 
        RowBox[{"EE", "->", 
         RowBox[{"210", " ", 
          SuperscriptBox["10", "9"]}]}], ",", 
        RowBox[{"J", "->", 
         RowBox[{"8", " ", 
          SuperscriptBox["10", 
           RowBox[{"-", "6"}]]}]}], ",", 
        RowBox[{"q", "->", 
         RowBox[{"5", " ", 
          SuperscriptBox["10", "3"]}]}]}], "}"}]}]}], "|>"}]}], 
  ";"}]}], "Input",
