Cell[CellGroupData[{

Cell["Key feature: make use of analytical solutions", "Chapter",
 CellChangeTimes->{{3.992647019628908*^9, 
  3.992647029748825*^9}},ExpressionUUID->"c4984ecd-be74-9f42-8ab2-\
11b24b9634ef"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s make the diagrams interactive: move the force P and \
the moment M along the beam. To animate the diagrams, we will use ",
 StyleBox["Manipulate",
  FontSlant->"Italic"],
 ". Because our deflection solution is analytical, ",
 StyleBox["Manipulate",
  FontSlant->"Italic"],
 " is nice and fast:"
}], "Text",
 CellChangeTimes->{{3.855805188210103*^9, 3.8558052500939045`*^9}, {
  3.9962941433330307`*^9, 3.996294152201933*^9}, {3.998881495199501*^9, 
  3.9988814980784855`*^9}, {3.998882557991659*^9, 3.998882703103855*^9}, {
  3.998883028888275*^9, 
  3.9988830321833897`*^9}},ExpressionUUID->"965eef9e-6f26-4255-92c5-\
8ae05e937af8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "@", "supp"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"supp", "[", 
    RowBox[{"x_", ",", "size_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hCoeff", "=", "100"}], "}"}], ",", 
     RowBox[{"Triangle", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "-", "size"}], ",", 
          RowBox[{
           RowBox[{"-", "hCoeff"}], " ", "size"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "+", "size"}], ",", 
          RowBox[{
           RowBox[{"-", "hCoeff"}], " ", "size"}]}], "}"}]}], "}"}], "]"}]}], 
    "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "[", "pointLoad", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "pointLoad", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<ArrowLength\>\"", "->", "55"}], ",", 
     RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.04"}], ",", 
     RowBox[{"\"\<Style\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", 
        RowBox[{"Thickness", "[", "0.008", "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Label\>\"", "->", "None"}], ",", 
     RowBox[{"\"\<LabelOffset\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"14", ",", "0"}], "}"}]}], ",", 
     RowBox[{"\"\<LabelStyle\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", "14", ",", "Italic"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pointLoad", "[", 
     RowBox[{"f_", ",", 
      RowBox[{"xP_", "?", "NumericQ"}], ",", 
      RowBox[{"force_", "?", "NumericQ"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "direction", ",", "arrowLength", ",", "tip", ",", "tail", ",", "label",
         ",", "labelOffset", ",", "labelPosition"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Chop", "[", "force", "]"}], "==", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"direction", "=", 
        RowBox[{"Sign", "[", "force", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"arrowLength", "=", 
        RowBox[{"OptionValue", "[", "\"\<ArrowLength\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"label", "=", 
        RowBox[{"OptionValue", "[", "\"\<Label\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"labelOffset", "=", 
        RowBox[{"OptionValue", "[", "\"\<LabelOffset\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tip", "=", 
        RowBox[{"{", 
         RowBox[{"xP", ",", 
          RowBox[{"f", "[", "xP", "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tail", "=", 
        RowBox[{"Offset", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"direction", " ", "arrowLength"}]}], "}"}], ",", "tip"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"labelPosition", "=", 
        RowBox[{"Offset", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"labelOffset", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"direction", " ", 
              RowBox[{"arrowLength", "/", "2"}]}], "+", 
             RowBox[{"labelOffset", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "tip"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Style\>\"", "]"}], ",", 
         RowBox[{"Arrowheads", "[", 
          RowBox[{"OptionValue", "[", "\"\<ArrowheadSize\>\"", "]"}], "]"}], ",", 
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{"tail", ",", "tip"}], "}"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"label", "===", "None"}], ",", "Nothing", ",", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"label", ",", 
               RowBox[{"OptionValue", "[", "\"\<LabelStyle\>\"", "]"}]}], 
              "]"}], ",", "labelPosition"}], "]"}]}], "]"}]}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "@", "uniformDistributedLoad"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "uniformDistributedLoad", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<NumberOfArrows\>\"", "->", "9"}], ",", 
     RowBox[{"\"\<ArrowLength\>\"", "->", "24"}], ",", 
     RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.025"}], ",", 
     RowBox[{"\"\<ShowLoadLine\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<Style\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"AbsoluteThickness", "[", "1.6", "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Label\>\"", "->", "None"}], ",", 
     RowBox[{"\"\<LabelStyle\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "14", ",", "Italic"}], "]"}]}], ",", 
     RowBox[{"\"\<LabelGap\>\"", "->", "15"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uniformDistributedLoad", "[", 
     RowBox[{"f_", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x1_", "?", "NumericQ"}], ",", 
        RowBox[{"x2_", "?", "NumericQ"}]}], "}"}], ",", 
      RowBox[{"q_", "?", "NumericQ"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "arrowLength", ",", "xs", ",", "beamPoints", ",", 
        "loadPoints", ",", "label", ",", "labelPoint", ",", "xMid"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Chop", "[", "q", "]"}], "==", "0"}], "||", 
          RowBox[{"x2", "<=", "x1"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"2", ",", 
          RowBox[{"Round", "@", 
           RowBox[{"OptionValue", "[", "\"\<NumberOfArrows\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"arrowLength", "=", 
        RowBox[{"OptionValue", "[", "\"\<ArrowLength\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"label", "=", 
        RowBox[{"OptionValue", "[", "\"\<Label\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xs", "=", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"x1", ",", "x2", ",", 
          RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"beamPoints", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"f", "[", "#", "]"}]}], "}"}], "&"}], ")"}], "/@", 
         "xs"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"loadPoints", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Offset", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"Sign", "[", "q", "]"}], " ", "arrowLength"}]}], 
              "}"}], ",", "#"}], "]"}], "&"}], ")"}], "/@", "beamPoints"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"xMid", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x1", "+", "x2"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"labelPoint", "=", 
        RowBox[{"Offset", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"Sign", "[", "q", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"arrowLength", "+", 
               RowBox[{"OptionValue", "[", "\"\<LabelGap\>\"", "]"}]}], 
              ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xMid", ",", 
            RowBox[{"f", "[", "xMid", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Style\>\"", "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "@", 
            RowBox[{"OptionValue", "[", "\"\<ShowLoadLine\>\"", "]"}]}], ",", 
           RowBox[{"Line", "[", "loadPoints", "]"}], ",", "Nothing"}], "]"}], 
         ",", 
         RowBox[{"Arrowheads", "[", 
          RowBox[{"OptionValue", "[", "\"\<ArrowheadSize\>\"", "]"}], "]"}], ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Arrow", "[", 
             RowBox[{"{", 
              RowBox[{"#1", ",", "#2"}], "}"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"loadPoints", ",", "beamPoints"}], "}"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"label", "===", "None"}], ",", "Nothing", ",", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"label", ",", 
               RowBox[{"OptionValue", "[", "\"\<LabelStyle\>\"", "]"}]}], 
              "]"}], ",", "labelPoint"}], "]"}]}], "]"}]}], "}"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "@", "beamMoment"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "beamMoment", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Direction\>\"", "->", "Automatic"}], ",", 
     RowBox[{"\"\<Offset\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "32"}], "}"}]}], ",", 
     RowBox[{"\"\<Size\>\"", "->", "48"}], ",", 
     RowBox[{"\"\<SweepAngle\>\"", "->", 
      RowBox[{"3", " ", 
       RowBox[{"Pi", "/", "2"}]}]}], ",", 
     RowBox[{"\"\<StartAngle\>\"", "->", 
      RowBox[{"3", " ", 
       RowBox[{"Pi", "/", "4"}]}]}], ",", 
     RowBox[{"\"\<Samples\>\"", "->", "50"}], ",", 
     RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.16"}], ",", 
     RowBox[{"\"\<Style\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Blue", ",", 
        RowBox[{"AbsoluteThickness", "[", "1.8", "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Label\>\"", "->", "None"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beamMoment", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"xM_", "?", "NumericQ"}], ",", 
     RowBox[{"moment_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
