Cell[BoxData[{
 RowBox[{"ClearAll", "@", "beamMoment"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "beamMoment", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Direction\>\"", "->", "Automatic"}], ",", 
     RowBox[{"\"\<Offset\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "32"}], "}"}]}], ",", 
     RowBox[{"\"\<Size\>\"", "->", "48"}], ",", 
     RowBox[{"\"\<SweepAngle\>\"", "->", 
      RowBox[{"3", " ", 
       RowBox[{"Pi", "/", "2"}]}]}], ",", 
     RowBox[{"\"\<StartAngle\>\"", "->", 
      RowBox[{"3", " ", 
       RowBox[{"Pi", "/", "4"}]}]}], ",", 
     RowBox[{"\"\<Samples\>\"", "->", "50"}], ",", 
     RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.16"}], ",", 
     RowBox[{"\"\<Style\>\"", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"AbsoluteThickness", "[", "1.8", "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Label\>\"", "->", "None"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beamMoment", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"xM_", "?", "NumericQ"}], ",", 
     RowBox[{"moment_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "direction", ",", "startAngle", ",", "endAngle", ",", "angles", ",", 
       "momentPoints", ",", "label", ",", "momentGraphic"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Chop", "[", "moment", "]"}], "==", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"direction", "=", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Direction\>\"", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Automatic", ":>", 
            RowBox[{"Sign", "[", "moment", "]"}]}], ",", 
           RowBox[{"\"\<CCW\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<CW\>\"", "->", 
            RowBox[{"-", "1"}]}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"startAngle", "=", 
       RowBox[{"OptionValue", "[", "\"\<StartAngle\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"endAngle", "=", 
       RowBox[{"startAngle", "+", 
        RowBox[{"direction", " ", 
         RowBox[{"OptionValue", "[", "\"\<SweepAngle\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"angles", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"startAngle", ",", "endAngle", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"12", ",", 
           RowBox[{"Round", "@", 
            RowBox[{"OptionValue", "[", "\"\<Samples\>\"", "]"}]}]}], "]"}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"momentPoints", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "#", "]"}], ",", 
            RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}], ")"}], "/@", 
        "angles"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{"OptionValue", "[", "\"\<Label\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"momentGraphic", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Style\>\"", "]"}], ",", 
           RowBox[{"Arrowheads", "[", 
            RowBox[{"OptionValue", "[", "\"\<ArrowheadSize\>\"", "]"}], "]"}],
            ",", 
           RowBox[{"Arrow", "[", "momentPoints", "]"}]}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.25"}], ",", "1.25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.25"}], ",", "1.25"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"ImagePadding", "->", "0"}], ",", 
         RowBox[{"Background", "->", "None"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Inset", "[", 
         RowBox[{"momentGraphic", ",", 
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Offset\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"xM", ",", 
              RowBox[{"f", "[", "xM", "]"}]}], "}"}]}], "]"}], ",", "Center", 
          ",", 
          RowBox[{"Offset", "[", 
           RowBox[{"OptionValue", "[", "\"\<Size\>\"", "]"}], "]"}]}], "]"}], 
        ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"label", "===", "None"}], ",", "Nothing", ",", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"label", ",", "14", ",", "Italic"}], "]"}], ",", 
            RowBox[{"Offset", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"OptionValue", "[", "\"\<Offset\>\"", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"OptionValue", "[", "\"\<Offset\>\"", "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"OptionValue", "[", "\"\<Size\>\"", "]"}], "/", 
                  "2"}], "+", "0.5"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"xM", ",", 
                RowBox[{"f", "[", "xM", "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}]}], "Input",
