  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"beam4", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Supports\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
