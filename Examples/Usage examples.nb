          SuperscriptBox["10", 
           RowBox[{"-", "6"}]]}]}], ",", 
        RowBox[{"M0", "->", 
         RowBox[{"10", " ", 
          SuperscriptBox["10", "3"]}]}]}], "}"}]}]}], "|>"}]}], 
