         RowBox[{"210", " ", 
          SuperscriptBox["10", "9"]}]}], ",", 
        RowBox[{"J", "->", 
         RowBox[{"8", " ", 
          SuperscriptBox["10", 
           RowBox[{"-", "6"}]]}]}], ",", 
        RowBox[{"q", "->", 
         RowBox[{"5", " ", 
          SuperscriptBox["10", "3"]}]}]}], "}"}]}]}], "|>"}]}], 
