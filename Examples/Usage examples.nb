Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"L", ",", "EE", ",", "J", ",", "P", ",", "a", ",", "x"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"beam6", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Supports\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Pin\>\""}], ",", 
          RowBox[{"\"\<x\>\"", "->", "0"}]}], "|>"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Pin\>\""}], ",", 
          RowBox[{"\"\<x\>\"", "->", "L"}]}], "|>"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Loadings\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<Force\>\""}], ",", 
         RowBox[{"\"\<x\>\"", "->", "a"}], ",", 
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"-", "P"}]}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Length\>\"", "->", "L"}], ",", 
     RowBox[{"\"\<E\>\"", "->", "EE"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
     RowBox[{"\"\<Numbers\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"L", "->", "4"}], ",", 
        RowBox[{"EE", "->", 
         RowBox[{"210", " ", 
          SuperscriptBox["10", "9"]}]}], ",", 
        RowBox[{"J", "->", 
         RowBox[{"8", " ", 
          SuperscriptBox["10", 
           RowBox[{"-", "6"}]]}]}], ",", 
        RowBox[{"P", "->", 
         RowBox[{"10", " ", 
          SuperscriptBox["10", "3"]}]}], ",", 
        RowBox[{"a", "->", "1.5"}]}], "}"}]}]}], "|>"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9962928770797462`*^9, 3.9962928770797462`*^9}, 
   3.996293072168602*^9, 3.9962932278257236`*^9, {3.9962947345503807`*^9, 
