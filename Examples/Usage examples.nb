Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"L", ",", "EE", ",", "J", ",", "q", ",", "x"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"beam5", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Supports\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<FixedEnd\>\""}], ",", 
         RowBox[{"\"\<x\>\"", "->", "0"}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Loadings\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<Distributed\>\""}], ",", 
         RowBox[{"\"\<x begin\>\"", "->", "0"}], ",", 
         RowBox[{"\"\<x end\>\"", "->", "L"}], ",", 
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"-", "q"}]}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Length\>\"", "->", "L"}], ",", 
     RowBox[{"\"\<E\>\"", "->", "EE"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
     RowBox[{"\"\<Numbers\>\"", "->", 
      RowBox[{"{", 
