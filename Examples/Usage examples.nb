Cell[BoxData[
 RowBox[{
  RowBox[{"theoreticalValues4", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<ReactionForce\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<ReactionMoment\>\"", "->", 
