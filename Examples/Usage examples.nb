Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"L", ",", "EE", ",", "J", ",", "P", ",", "x"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"beam3", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Supports\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<FixedEnd\>\""}], ",", 
         RowBox[{"\"\<x\>\"", "->", "0"}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Loadings\>\"", "->", 
