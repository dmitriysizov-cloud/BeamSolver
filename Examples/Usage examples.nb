         RowBox[{"\"\<Value\>\"", "->", "M0"}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Length\>\"", "->", "L"}], ",", 
     RowBox[{"\"\<E\>\"", "->", "EE"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
     RowBox[{"\"\<Numbers\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"L", "->", "4"}], ",", 
