Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "a", ",", "b", ",", "c", ",", "q", ",", "M", ",", "P", ",", "xP", ",", 
     "xM", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"myBeam", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Supports\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Pin\>\""}], ",", 
          RowBox[{"\"\<x\>\"", "->", "a"}]}], "|>"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Pin\>\""}], ",", 
          RowBox[{"\"\<x\>\"", "->", 
           RowBox[{"a", "+", "b", "+", "c"}]}]}], "|>"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Loadings\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Force\>\""}], ",", 
          RowBox[{"\"\<x\>\"", "->", "xP"}], ",", 
          RowBox[{"\"\<Value\>\"", "->", 
           RowBox[{"-", "P"}]}]}], "|>"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Moment\>\""}], ",", 
          RowBox[{"\"\<x\>\"", "->", "xM"}], ",", 
          RowBox[{"\"\<Value\>\"", "->", 
           RowBox[{"-", "M"}]}]}], "|>"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Distributed\>\""}], ",", 
          RowBox[{"\"\<x begin\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<x end\>\"", "->", "a"}], ",", 
          RowBox[{"\"\<Value\>\"", "->", 
           RowBox[{
            RowBox[{"-", "2"}], " ", "q"}]}]}], "|>"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Distributed\>\""}], ",", 
          RowBox[{"\"\<x begin\>\"", "->", 
           RowBox[{"a", "+", "b"}]}], ",", 
          RowBox[{"\"\<x end\>\"", "->", 
           RowBox[{"a", "+", "b", "+", "c"}]}], ",", 
          RowBox[{"\"\<Value\>\"", "->", "q"}]}], "|>"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Length\>\"", "->", 
      RowBox[{"a", "+", "b", "+", "c"}]}], ",", 
     RowBox[{"\"\<E\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Numbers\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "->", "2."}], ",", 
        RowBox[{"b", "->", "1.6"}], ",", 
        RowBox[{"c", "->", "2.4"}], ",", 
        RowBox[{"q", "->", "4."}], ",", 
        RowBox[{"M", "->", "12."}], ",", 
        RowBox[{"P", "->", "10."}], ",", 
        RowBox[{"xP", "->", "3.6"}], ",", 
        RowBox[{"xM", "->", "2."}]}], "}"}]}]}], "|>"}]}], ";"}]}], "Input",
