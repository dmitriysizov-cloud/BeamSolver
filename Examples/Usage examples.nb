         RowBox[{"\"\<x\>\"", "->", "L"}], ",", 
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"-", "P"}]}]}], "|>"}], "}"}]}], ",", 
     RowBox[{"\"\<Length\>\"", "->", "L"}], ",", 
     RowBox[{"\"\<E\>\"", "->", "EE"}], ",", 
