      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"\<\"Type\"\>", "\[Rule]", "\<\"Moment\"\>"}], ",", 
        RowBox[{"\<\"x\"\>", "\[Rule]", "0"}], ",", 
        RowBox[{"\<\"Value\"\>", "\[Rule]", 
         RowBox[{"-", "M0"}]}], ",", 
        RowBox[{"\<\"Kind\"\>", "\[Rule]", "\<\"Reaction\"\>"}]}], 
       "\[RightAssociation]"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Length\"\>", "\[Rule]", "L"}], ",", 
   RowBox[{"\<\"E\"\>", "\[Rule]", "EE"}], ",", 
   RowBox[{"\<\"J\"\>", "\[Rule]", "J"}], ",", 
   RowBox[{"\<\"Boundary conditions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["BeamSolver`Private`y", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "M0"}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["BeamSolver`Private`y", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "L", "]"}], "\[Equal]", "M0"}], ",", 
      RowBox[{
       RowBox[{"BeamSolver`Private`y", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
