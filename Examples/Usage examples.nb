Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedRules", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"myBeam", "[", "\"\<Numbers\>\"", "]"}], ",", 
     RowBox[{"HoldPattern", "[", 
      RowBox[{"xP", "->", "_"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"an", ",", "bn", ",", "cn", ",", "Ln"}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", 
      RowBox[{"a", "+", "b", "+", "c"}]}], "}"}], "/.", " ", "fixedRules"}]}],
   ";"}]}], "Input",
