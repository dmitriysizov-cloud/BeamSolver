Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"deflectionExpression", ",", "f"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflectionExpression", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"myBeamSolved", "[", "\"\<Solutions\>\"", "]"}], 
           "[", "\"\<Deflection\>\"", "]"}], "[", "x", "]"}], "/.", 
         "\[IndentingNewLine]", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"myBeamSolved", "[", "\"\<Numbers\>\"", "]"}], ",", 
           RowBox[{"HoldPattern", "[", 
            RowBox[{"xP", "->", "_"}], "]"}]}], "]"}]}], "/.", 
        "\[IndentingNewLine]", 
        RowBox[{"xP", "->", "xPP"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f", "=", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "xx", "}"}], ",", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"deflectionExpression", "/.", " ", 
           RowBox[{"x", "->", "xx"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"f", "[", "x", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "Ln"}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "120"}], ",", "40"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Epilog", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pointLoad", "[", 
            RowBox[{"f", ",", "xPP", ",", "1", ",", 
             RowBox[{"\"\<Label\>\"", "->", "\"\<P\>\""}], ",", 
             RowBox[{"\"\<LabelOffset\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"10", ",", "15"}], "}"}]}]}], "]"}], ",", 
           RowBox[{"uniformDistributedLoad", "[", 
            RowBox[{"f", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "an"}], "}"}], ",", "1", ",", 
             RowBox[{"\"\<NumberOfArrows\>\"", "->", "7"}], ",", 
             RowBox[{"\"\<ArrowLength\>\"", "->", "22"}], ",", 
             RowBox[{"\"\<Label\>\"", "->", "\"\<2q\>\""}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"uniformDistributedLoad", "[", 
            RowBox[{"f", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"an", "+", "bn"}], ",", "Ln"}], "}"}], ",", 
             RowBox[{"-", "1"}], ",", 
             RowBox[{"\"\<NumberOfArrows\>\"", "->", "8"}], ",", 
             RowBox[{"\"\<ArrowLength\>\"", "->", "20"}], ",", 
             RowBox[{"\"\<Label\>\"", "->", "\"\<q\>\""}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"beamMoment", "[", 
            RowBox[{"f", ",", "an", ",", "1", ",", 
             RowBox[{"\"\<Offset\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], ",", 
             RowBox[{"\"\<Size\>\"", "->", "80"}], ",", 
             RowBox[{"\"\<ArrowheadSize\>\"", "->", "0.2"}], ",", 
             RowBox[{"\"\<Label\>\"", "->", "\"\<M\>\""}], ",", 
             RowBox[{"\"\<Direction\>\"", "->", "\"\<CW\>\""}]}], "]"}], ",", 
           RowBox[{"supp", "[", 
            RowBox[{"an", ",", "0.1"}], "]"}], ",", 
           RowBox[{"supp", "[", 
            RowBox[{"Ln", ",", "0.1"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"PerformanceGoal", "->", "\"\<Quality\>\""}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", "\"\<Deflection\>\""}], "}"}]}]}], "]"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xPP", ",", 
       RowBox[{"xP", "/.", " ", 
        RowBox[{"myBeam", "[", "\"\<Numbers\>\"", "]"}]}], ",", 
       RowBox[{"Subscript", "[", 
        RowBox[{"x", ",", "P"}], "]"}]}], "}"}], ",", "0", ",", "Ln", ",", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
   RowBox[{"TrackedSymbols", ":>", 
    RowBox[{"{", "xPP", "}"}]}], ",", 
   RowBox[{"SaveDefinitions", "->", "False"}]}], "]"}]], "Input",
